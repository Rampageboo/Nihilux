{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "app",
  "description": "The app page served by the local backend: version, updates and restart.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "allow-app-info",
    "allow-retry-backend",
    "allow-prepare-for-update"
  ]
}
