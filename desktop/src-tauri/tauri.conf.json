{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nihilux",
  "mainBinaryName": "Nihilux",
  "version": "0.1.1",
  "identifier": "app.nihilux.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nihilux",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "maximized": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#111318"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default", "app"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [],
    "icon": ["../../storyboard_tool/assets/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEOTlFM0E2Q0Y5MEE2OEQKUldTTnBwRFBwdU9aalVnc0s4ZWZKdTdGTThPek1QOEVqUGtrYnppNzZ1MnJQaVZvdnFLZFl4aUwK",
      "endpoints": [
        "https://github.com/Rampageboo/Nihilux/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
